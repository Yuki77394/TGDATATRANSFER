# === Saved Messages Migration (Source → Target) ===

# Telegram API credentials — get from https://my.telegram.org
# Shared by both source and target clients.
API_ID=
API_HASH=

# Telethon StringSession strings.
# Generate locally with: python generate_session.py
# (run twice — once for source, once for target)
SOURCE_SESSION=
TARGET_SESSION=

# Persistent data directory (Railway Volume mount point).
# On Railway, mount a persistent Volume at /app/data and set this to /app/data.
DATA_DIR=/app/data

# --- Optional ---

# Maximum retry attempts for downloads/uploads (default: 3)
# MAX_RETRIES=3

# Save state to disk every N messages (default: 10)
# CHECKPOINT_EVERY=10

# SAFETY OVERRIDE: Allow source and target to be the same account.
# NOT recommended — will duplicate all messages. (default: false)
# ALLOW_SAME_ACCOUNT=false

# Delete local media files after successful upload. (default: false)
# Set to true to save disk space on the Volume.
# DELETE_AFTER_UPLOAD=false
