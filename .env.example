# Telegram API credentials - get these from https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash_here
PHONE=+10000000000

# Session name (the Telethon session file will be named <SESSION_NAME>.session)
# Only used for file-based sessions (local). Ignored if SESSION_STRING is set.
SESSION_NAME=telegram_backup_session

# --- Heroku / cloud deployment ---
# SESSION_STRING: Telethon StringSession (preferred for Heroku).
# Generate locally with: python generate_session.py
# Then set as a Heroku Config Var. When set, file-based session is NOT used.
# SESSION_STRING=

# Non-interactive auth (alternative to SESSION_STRING for first run on Heroku).
# If SESSION_STRING is not set, these are used instead of interactive prompts.
# WARNING: less secure than SESSION_STRING. Prefer the session-string workflow.
# TG_OTP_CODE=
# TG_2FA_PASSWORD=

# What to back up
BACKUP_SAVED_MESSAGES=true
BACKUP_PRIVATE_CHATS=true
# Groups and channels are OFF by default - opt-in only
BACKUP_GROUPS=false
BACKUP_CHANNELS=false
# Whether to include bot conversations in private chat backup
INCLUDE_BOTS=true

# Media options
BACKUP_MEDIA=true
DOWNLOAD_PHOTOS=true
DOWNLOAD_VIDEOS=true
DOWNLOAD_DOCUMENTS=true
DOWNLOAD_AUDIO=true
DOWNLOAD_VOICE=true

# Max media file size in MB (0 = no limit)
MAX_PHOTO_SIZE_MB=0
MAX_VIDEO_SIZE_MB=0
MAX_DOCUMENT_SIZE_MB=0

# Reliability
MAX_RETRIES=3
# Save state to disk every N messages (checkpoint frequency)
CHECKPOINT_EVERY=50

# Output base directory (relative to project root or absolute)
# On Heroku, the dyno filesystem is EPHEMERAL — files are lost on restart.
# For local use, "telegram_backup" is fine. For Heroku, you may want to set
# this to an absolute path like /tmp/telegram_backup (still ephemeral).
BACKUP_DIR=telegram_backup
